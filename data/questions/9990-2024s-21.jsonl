{"id": "9990-2024s-21-q4a", "paper": {"code": "9990/21", "no": 2, "variant": 1}, "series": {"year": 2024, "session": "s", "label": "2024 May/June"}, "syllabus_version": "2024-2026", "q_no": "4", "part": "a", "subpart": null, "marks": 2, "section": "A", "stem_text": "Glyn is conducting an experiment with an independent measures design. He is testing the effect \nof background noise on social learning (learning by imitation). Glyn shows each participant how to \nbuild a tower from blocks. Each participant then builds this tower, with either singing or silence in \nthe background.", "text": "Explain what is meant by an ‘independent measures design’, including an example from \nGlyn’s study.\n ...................................................................................................................................................\n ...................................................................................................................................................\n ...................................................................................................................................................\n ............................................................................................................................................. [2]", "has_figure": false, "topics": ["method.experiment", "concept.data_analysis"], "type_facet": null, "command_words": ["explain"], "marks_source": "extracted", "confidence": {"structure": 1.0, "topic": 0.7, "type": 0.0}, "source": {"file": "9990_s24_qp_21.pdf", "page": null}, "reviewed_by": null, "reviewed_at": null}
