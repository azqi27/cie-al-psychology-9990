---
import '../styles/global.css';
import {
  TOPICS_BY_PAPER,
  TOPIC_LABELS,
  TYPE_LABELS,
  CMD_LABELS,
  SESSION_LABELS,
  PAPER_LABELS,
} from '../lib/taxonomy';

const BASE_URL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>题库校对后台 · CIE A-Level Psychology 9990</title>
    <meta name="description" content="Review and edit question tags for the CIE A-Level Psychology 9990 question bank." />
  </head>
  <body class="bg-gray-50 text-gray-800">
    <header class="site-header">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <h1>CIE A-Level Psychology 9990</h1>
        <p class="site-sub">by Angel Zhang</p>
      </div>
    </header>

    <!-- 密码 gate（每次访问都需要验证） -->
    <div id="gate" class="fixed inset-0 z-50 flex flex-col items-center justify-center">
      <div class="bg-white border border-gray-200 rounded-lg shadow-xl p-6 w-80">
        <h2 class="text-lg font-bold text-theme-dark mb-2">管理员验证</h2>
        <p class="text-sm text-gray-600 mb-3">请输入后台密码</p>
        <div class="flex items-center gap-2">
          <input
            id="pw"
            type="password"
            class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-theme"
            placeholder="Password"
          />
          <button id="pw-help" class="help-btn" title="提示" aria-label="帮助">?</button>
        </div>
        <div id="pw-hint" class="help-tip hidden">提示：选手编号</div>
        <button id="pw-btn" class="bg-theme text-white px-4 py-2 rounded w-full mt-3 hover-bg-theme">进入</button>
        <p id="pw-err" class="text-red-600 text-xs mt-2 hidden">密码错误</p>
      </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 py-5">
      <div id="loading" class="text-center text-gray-400 text-sm py-10">正在加载题库…</div>

      <div id="app" class="hidden">
        <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-900">
          <strong>如何使用：</strong>
          点任意题目的 <em>编辑</em>，编辑器会在该题<strong>下方</strong>就地展开；正在编辑的行会高亮。
          可修改任意字段：来源标签、题面、大题干、对应实验/视角（可多选）、研究切面、命令词、分值。
          改完后点 <em>发布到网站</em> 即可把改动<strong>永久写入题库并即时更新线上</strong>（需填写下方 GitHub Token）。
          也可点 <em>导出 JSON</em> 把改动下载下来发给我人工处理。
        </div>

        <div class="flex flex-wrap gap-2 items-center mb-3">
          <input
            id="adm-search"
            type="search"
            placeholder="按编号 / 题号 / 题面筛选…"
            class="border rounded px-2 py-1.5 text-sm text-gray-800 w-64"
          />
          <button id="btn-expand" class="text-sm px-3 py-1.5 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300">展开全部</button>
          <button id="btn-collapse" class="text-sm px-3 py-1.5 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300">收起全部</button>
          <span class="grow"></span>
          <label class="flex items-center gap-1 text-xs text-gray-600">
            GitHub Token
            <input id="gh-token" type="password" placeholder="粘贴你的 PAT（repo 权限）" class="border rounded px-2 py-1.5 text-sm w-56" />
          </label>
          <button id="btn-publish" class="text-sm px-3 py-1.5 rounded bg-emerald-600 text-white hover:bg-emerald-700">发布到网站</button>
          <button id="btn-export" class="text-sm px-3 py-1.5 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300">导出 JSON</button>
          <button id="btn-copy" class="text-sm px-3 py-1.5 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300">复制 JSON</button>
          <span id="changed-count" class="text-sm text-emerald-700 font-semibold"></span>
        </div>
        <p id="save-status" class="hidden text-sm text-emerald-700 font-semibold -mt-2 mb-3"></p>

        <div class="overflow-auto border rounded-lg bg-white">
          <table class="admin-table">
            <thead>
              <tr>
                <th style="width:9%">编号</th>
                <th style="width:17%">来源</th>
                <th style="width:32%">题面</th>
                <th style="width:20%">知识点 / 视角</th>
                <th style="width:10%">研究切面</th>
                <th style="width:12%">操作</th>
              </tr>
            </thead>
            <tbody id="adm-body"></tbody>
          </table>
        </div>

        <div class="mt-4">
          <p class="text-xs text-gray-500 mb-1">导出预览（仅含已改动题目）：</p>
          <textarea id="json-preview" readonly placeholder="暂无改动"></textarea>
        </div>
      </div>
    </main>

    <script define:vars={{ TOPICS_BY_PAPER, TOPIC_LABELS, TYPE_LABELS, CMD_LABELS, SESSION_LABELS, PAPER_LABELS, BASE_URL }}>
      const $ = (id) => document.getElementById(id);
      const BASE = BASE_URL;
      const REPO = 'azqi27/cie-al-psychology-9990';
      const API = 'https://api.github.com';
      const body = $('adm-body');
      const groups = TOPICS_BY_PAPER[1] || [];
      const STORAGE_KEY = 'qb-edits-cie-al-psychology-9990';
      const TOKEN_KEY = 'gh-token-cie-al-psychology-9990';

      // —— 密码 gate：每次访问都要求 ——
      const gate = $('gate');
      const PASS = '08042';
      $('pw-btn').addEventListener('click', () => {
        if ($('pw').value === PASS) gate.hidden = true;
        else $('pw-err').classList.remove('hidden');
      });
      $('pw').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('pw-btn').click(); });
      $('pw-help').addEventListener('click', () => $('pw-hint').classList.toggle('hidden'));

      // —— Token 输入记忆（仅存本机，不写入源码）——
      const tokenInput = $('gh-token');
      tokenInput.value = localStorage.getItem(TOKEN_KEY) || '';
      tokenInput.addEventListener('input', () => localStorage.setItem(TOKEN_KEY, tokenInput.value.trim()));

      const esc = (s) =>
        String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

      let DATA = [];
      const ORIG = {};
      const edits = {};

      const cur = (id) => edits[id] || ORIG[id];
      const topicLabel = (id) => TOPIC_LABELS[id] ?? id;
      const typeLabel = (id) => TYPE_LABELS[id] ?? id;

      function snapEq(a, b) {
        const keys = ['text', 'stem_text', 'topics', 'type_facet', 'command_words', 'marks', 'year', 'session', 'paper_no', 'variant', 'q_no', 'part'];
        return keys.every((k) => {
          if (k === 'topics' || k === 'command_words') {
            const x = a[k] || [], y = b[k] || [];
            return x.length === y.length && x.every((v, i) => v === y[i]);
          }
          return (a[k] ?? '') === (b[k] ?? '');
        });
      }

      function setField(id, field, value) {
        if (!edits[id]) edits[id] = { ...ORIG[id] };
        edits[id][field] = value;
        if (snapEq(edits[id], ORIG[id])) delete edits[id];
        refreshRow(DATA.find((q) => q.id === id));
        updateSummary();
      }

      function refreshRow(q) {
        const tr = body.querySelector(`tr[data-id="${q.id}"]`);
        if (!tr) return;
        const s = cur(q.id);
        tr.querySelector('.cell-tags').innerHTML = (s.tags || []).filter((t) => t !== '').map((t) => `<span class="badge bg-gray-100 text-gray-600">${esc(t)}</span>`).join(' ');
        tr.querySelector('.cell-text').textContent = s.text || '';
        tr.querySelector('.cell-topics').innerHTML = (s.topics || []).map((t) => `<span class="badge bg-emerald-50 text-emerald-700">${esc(topicLabel(t))}</span>`).join(' ');
        tr.querySelector('.cell-type').textContent = typeLabel(s.type_facet || 'other');
        const changed = !!edits[q.id];
        tr.classList.toggle('editing', changed);
        const dr = body.querySelector(`tr.detail-row[data-did="${q.id}"]`);
        if (dr) dr.classList.toggle('editing', changed);
        const flag = tr.querySelector('.changed-flag');
        if (flag) flag.style.display = changed ? '' : 'none';
      }

      function buildEditor(q) {
        const s = cur(q.id);
        const wrap = document.createElement('div');
        wrap.className = 'editor';
        wrap.innerHTML = `<div class="ed-head">正在编辑：<span class="mono">${esc(s.uid)}</span> <span class="editing-pill">编辑中</span></div>`;

        const srcRow = document.createElement('div'); srcRow.className = 'ed-row';
        srcRow.innerHTML = '<label class="ed-lbl">来源标签 (Source)</label>';
        const grid = document.createElement('div'); grid.className = 'src-grid';
        const srcFields = [['year', 'Year', 'number'], ['session', 'Session', 'select', [['m', 'march'], ['s', 'summer'], ['w', 'winter']]], ['paper_no', 'Paper', 'number'], ['variant', 'Variant', 'number'], ['q_no', 'Q no', 'text'], ['part', 'Part', 'text']];
        srcFields.forEach((f) => {
          const cell = document.createElement('div');
          const lab = document.createElement('label'); lab.className = 'ed-lbl plain'; lab.textContent = f[1];
          let inp;
          if (f[2] === 'select') { inp = document.createElement('select'); f[3].forEach(([v, l]) => { const o = document.createElement('option'); o.value = v; o.textContent = l; inp.appendChild(o); }); }
          else { inp = document.createElement('input'); inp.type = f[2]; }
          inp.value = s[f[0]] ?? '';
          inp.addEventListener('input', () => setField(q.id, f[0], f[2] === 'number' ? (inp.value ? Number(inp.value) : null) : inp.value));
          cell.appendChild(lab); cell.appendChild(inp); grid.appendChild(cell);
        });
        srcRow.appendChild(grid); wrap.appendChild(srcRow);

        const tRow = document.createElement('div'); tRow.className = 'ed-row';
        tRow.innerHTML = '<label class="ed-lbl">题面 (Question text)</label>';
        const ta = document.createElement('textarea'); ta.rows = 4; ta.value = s.text || '';
        ta.addEventListener('input', () => setField(q.id, 'text', ta.value));
        tRow.appendChild(ta); wrap.appendChild(tRow);

        const sRow = document.createElement('div'); sRow.className = 'ed-row';
        sRow.innerHTML = '<label class="ed-lbl">Context / 大题干（可选）</label>';
        const sa = document.createElement('textarea'); sa.rows = 2; sa.value = s.stem_text || '';
        sa.addEventListener('input', () => setField(q.id, 'stem_text', sa.value));
        sRow.appendChild(sa); wrap.appendChild(sRow);

        const tpRow = document.createElement('div'); tpRow.className = 'ed-row';
        tpRow.innerHTML = '<label class="ed-lbl">知识点 / 视角（可多选）</label>';
        groups.forEach((g) => {
          const gt = document.createElement('div'); gt.className = 'grp-title'; gt.textContent = g.label; tpRow.appendChild(gt);
          g.ids.forEach((id) => {
            const lab = document.createElement('label'); lab.className = 'study-chk';
            const cb = document.createElement('input'); cb.type = 'checkbox'; cb.value = id; cb.checked = (s.topics || []).includes(id);
            cb.addEventListener('change', () => { const checked = Array.from(tpRow.querySelectorAll('.study-chk input:checked')).map((c) => c.value); setField(q.id, 'topics', checked); });
            lab.appendChild(cb); lab.appendChild(document.createTextNode(topicLabel(id))); tpRow.appendChild(lab);
          });
        });
        wrap.appendChild(tpRow);

        const tyRow = document.createElement('div'); tyRow.className = 'ed-row';
        tyRow.innerHTML = '<label class="ed-lbl">研究切面 (Type)</label>';
        const sel = document.createElement('select');
        Object.entries(TYPE_LABELS).forEach(([id, label]) => { const o = document.createElement('option'); o.value = id; o.textContent = label; if ((s.type_facet || 'other') === id) o.selected = true; sel.appendChild(o); });
        sel.addEventListener('change', () => setField(q.id, 'type_facet', sel.value));
        tyRow.appendChild(sel); wrap.appendChild(tyRow);

        const cRow = document.createElement('div'); cRow.className = 'ed-row';
        cRow.innerHTML = '<label class="ed-lbl">命令词 (Command words，逗号分隔)</label>';
        const ci = document.createElement('input'); ci.type = 'text'; ci.value = (s.command_words || []).join(', ');
        ci.addEventListener('input', () => setField(q.id, 'command_words', ci.value.split(',').map((x) => x.trim()).filter(Boolean)));
        cRow.appendChild(ci); wrap.appendChild(cRow);

        const mRow = document.createElement('div'); mRow.className = 'ed-row';
        mRow.innerHTML = '<label class="ed-lbl">分值 (Marks)</label>';
        const mi = document.createElement('input'); mi.type = 'number'; mi.value = s.marks ?? '';
        mi.addEventListener('input', () => setField(q.id, 'marks', mi.value ? Number(mi.value) : null));
        mRow.appendChild(mi); wrap.appendChild(mRow);

        const act = document.createElement('div'); act.className = 'ed-actions';
        const done = document.createElement('button'); done.className = 'save'; done.textContent = '完成';
        done.addEventListener('click', () => { const dr = body.querySelector(`tr.detail-row[data-did="${q.id}"]`); if (dr) dr.hidden = true; });
        const reset = document.createElement('button'); reset.className = 'reset'; reset.textContent = '重置本行';
        reset.addEventListener('click', () => { delete edits[q.id]; refreshRow(q); updateSummary(); const dr = body.querySelector(`tr.detail-row[data-did="${q.id}"]`); if (dr) { dr.hidden = true; dr.dataset.built = ''; dr.innerHTML = '<td colspan="6"></td>'; } });
        act.appendChild(done); act.appendChild(reset); wrap.appendChild(act);
        return wrap;
      }

      function buildTable() {
        DATA.forEach((q) => {
          const tr = document.createElement('tr'); tr.dataset.id = q.id;
          tr.innerHTML = `
            <td class="uid-cell">${esc(q.uid)}</td>
            <td><div class="cell-tags"></div></td>
            <td class="admin-text cell-text"></td>
            <td><div class="cell-topics"></div></td>
            <td class="cell-type"></td>
            <td>
              <button class="admin-edit-btn">编辑</button>
              <div class="changed-flag" style="display:none">已改</div>
            </td>`;
          const dr = document.createElement('tr'); dr.className = 'detail-row'; dr.dataset.did = q.id; dr.hidden = true; dr.innerHTML = '<td colspan="6"></td>';
          tr.querySelector('.admin-edit-btn').addEventListener('click', () => {
            if (dr.hidden) { if (!dr.dataset.built) { dr.appendChild(buildEditor(q)); dr.dataset.built = '1'; } dr.hidden = false; }
            else dr.hidden = true;
          });
          body.appendChild(tr); body.appendChild(dr); refreshRow(q);
        });
      }

      function updateSummary() {
        const ids = Object.keys(edits);
        $('changed-count').textContent = ids.length ? `已改动 ${ids.length} 题` : '';
        $('json-preview').value = ids.length ? JSON.stringify(buildPayload(), null, 2) : '';
      }

      function buildPayload() {
        const out = {};
        for (const id of Object.keys(edits)) {
          const e = edits[id];
          out[id] = { uid: ORIG[id]?.uid, text: e.text, stem_text: e.stem_text, topics: e.topics, type_facet: e.type_facet, command_words: e.command_words, marks: e.marks, series: { year: e.year, session: e.session }, paper: { no: e.paper_no, variant: e.variant }, q_no: e.q_no, part: e.part || null };
        }
        return { edited_at: new Date().toISOString(), edits: out };
      }

      // —— GitHub 永久发布 ——
      function b64(s) { return btoa(unescape(encodeURIComponent(s))); }
      async function ghGet(path) {
        const token = tokenInput.value.trim();
        const r = await fetch(`${API}${path}`, { headers: { Authorization: 'token ' + token, Accept: 'application/vnd.github+json' } });
        if (!r.ok) throw new Error(`GET ${path} -> ${r.status}`);
        return r.json();
      }
      async function ghPut(path, content, sha, message) {
        const token = tokenInput.value.trim();
        const r = await fetch(`${API}${path}`, { method: 'PUT', headers: { Authorization: 'token ' + token, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json' }, body: JSON.stringify({ message, content: b64(content), sha }) });
        if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(`PUT ${path} -> ${r.status} ${e.message || ''}`); }
        return true;
      }

      async function publish() {
        const ids = Object.keys(edits);
        if (!ids.length) { alert('暂无改动可发布。'); return; }
        const token = tokenInput.value.trim();
        if (!token) { alert('请先在右上角填写 GitHub Token（需要 repo 权限）。'); tokenInput.focus(); return; }
        if (!confirm(`确定把 ${ids.length} 题的改动永久发布到网站吗？`)) return;
        const status = $('save-status'); status.classList.remove('hidden'); status.style.color = '#2f4a63'; status.textContent = '正在发布…';
        try {
          // 1) 更新 gh-pages 的 data/questions.json（线上即时生效）
          const remote = DATA.map((q) => (edits[q.id] ? edits[q.id] : q));
          const live = await ghGet(`/repos/${REPO}/contents/data/questions.json?ref=gh-pages`);
          await ghPut(`/repos/${REPO}/contents/data/questions.json`, JSON.stringify(remote), live.sha, `Update questions via admin (${ids.length} edits)`);

          // 2) 回写 main 的 JSONL 源文件（保持单一真相源 / 历史）
          const byFile = {};
          for (const id of ids) { const f = ORIG[id].file; (byFile[f] = byFile[f] || new Set()).add(id); }
          for (const file of Object.keys(byFile)) {
            const gj = await ghGet(`/repos/${REPO}/contents/data/questions/${file}?ref=main`);
            const lines = atob(gj.content.replace(/\n/g, '')).split('\n').filter((l) => l.trim());
            const updated = lines.map((l) => {
              const o = JSON.parse(l);
              if (byFile[file].has(o.id)) { const e = edits[o.id]; o.text = e.text; o.stem_text = e.stem_text; o.topics = e.topics; o.type_facet = e.type_facet; o.command_words = e.command_words; o.marks = e.marks; o.series = { year: e.year, session: e.session }; o.paper = { no: e.paper_no, variant: e.variant }; o.q_no = e.q_no; o.part = e.part || null; }
              return JSON.stringify(o);
            });
            await ghPut(`/repos/${REPO}/contents/data/questions/${file}`, updated.join('\n') + '\n', gj.sha, `Update ${file} via admin`);
          }

          // 发布成功后，把改动并入原始快照，清除编辑态
          ids.forEach((id) => { ORIG[id] = { ...ORIG[id], ...edits[id] }; delete edits[id]; refreshRow(DATA.find((q) => q.id === id)); });
          updateSummary();
          status.style.color = '#16a34a';
          status.textContent = `✅ 已永久发布 ${ids.length} 题，线上约 1 分钟后生效。`;
          setTimeout(() => status.classList.add('hidden'), 6000);
        } catch (e) {
          status.style.color = '#dc2626';
          status.textContent = '发布失败：' + e.message + '（可改用“导出 JSON”发给我人工处理）';
          console.error(e);
        }
      }

      function exportJSON() {
        const payload = buildPayload();
        if (!payload || !Object.keys(payload.edits).length) { alert('暂无改动可导出。'); return; }
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'qb-edits.json'; a.click(); URL.revokeObjectURL(a.href);
      }
      async function copyJSON() {
        const val = $('json-preview').value;
        if (!val) { alert('暂无改动可复制。'); return; }
        try { await navigator.clipboard.writeText(val); alert('已复制到剪贴板。'); }
        catch { $('json-preview').select(); document.execCommand('copy'); alert('已选中，请按 Ctrl/Cmd+C 复制。'); }
      }

      $('adm-search').addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        DATA.forEach((d) => { d._hide = q && !(d.uid.toLowerCase().includes(q) || d.id.toLowerCase().includes(q) || d.text.toLowerCase().includes(q)); });
        body.querySelectorAll('tr[data-id]').forEach((tr) => { const d = DATA.find((x) => x.id === tr.dataset.id); const hide = d._hide; tr.style.display = hide ? 'none' : ''; const dr = body.querySelector(`tr.detail-row[data-did="${d.id}"]`); if (dr) dr.style.display = hide ? 'none' : ''; });
      });
      $('btn-expand').addEventListener('click', () => DATA.forEach((d) => { const dr = body.querySelector(`tr.detail-row[data-did="${d.id}"]`); if (dr && dr.hidden) { if (!dr.dataset.built) { dr.appendChild(buildEditor(d)); dr.dataset.built = '1'; } dr.hidden = false; } }));
      $('btn-collapse').addEventListener('click', () => body.querySelectorAll('tr.detail-row').forEach((dr) => (dr.hidden = true)));
      $('btn-publish').addEventListener('click', publish);
      $('btn-export').addEventListener('click', exportJSON);
      $('btn-copy').addEventListener('click', copyJSON);

      // —— 运行时加载题库 ——
      (async () => {
        try {
          const r = await fetch(BASE + 'data/questions.json', { cache: 'no-store' });
          if (!r.ok) throw new Error('HTTP ' + r.status);
          const arr = await r.json();
          DATA = arr.map((q) => ({
            id: q.id, uid: q.uid, file: q.file,
            tags: ['9990', String(q.series.year), SESSION_LABELS[q.series.session] || q.series.session, PAPER_LABELS[q.paper.no] ?? `Paper ${q.paper.no}`, `Variant ${q.paper.variant}`, `Q${q.q_no}`, q.part || ''],
            text: q.text, stem_text: q.stem_text, topics: q.topics, type_facet: q.type_facet, cmd: q.command_words, marks: q.marks,
            year: q.series.year, session: q.series.session, paper_no: q.paper.no, variant: q.paper.variant, q_no: q.q_no, part: q.part,
          }));
          DATA.forEach((q) => (ORIG[q.id] = { ...q }));
          $('loading').classList.add('hidden');
          $('app').classList.remove('hidden');
          buildTable();
          updateSummary();
        } catch (e) {
          $('loading').textContent = '题库加载失败：' + e.message;
          console.error(e);
        }
      })();
    </script>
  </body>
</html>
