---
import '../styles/global.css';
import { questions, effectiveType, sourceTags, seasonEn, partLabel } from '../lib/loadQuestions';
import {
  TOPIC_LABELS,
  TYPE_LABELS,
  CMD_LABELS,
  TOPICS_BY_PAPER,
  SESSION_LABELS,
  PAPER_LABELS,
} from '../lib/taxonomy';

const years = [...new Set(questions.map((q) => q.series.year))].sort((a, b) => a - b);
const sessions = [...new Set(questions.map((q) => q.series.session))].sort();
const cmds = [...new Set(questions.flatMap((q) => q.command_words))].filter(Boolean).sort();
const marksList = [
  ...new Set(questions.map((q) => q.marks).filter((m): m is number => m != null)),
].sort((a, b) => a - b);
const papersList = [1, 2, 3, 4];

// 数据中出现的、但不在已知分组里的知识点（防御性展示）
const knownIds = new Set(Object.values(TOPICS_BY_PAPER).flatMap((gs) => gs.flatMap((g) => g.ids)));
const extraTopics = [...new Set(questions.flatMap((q) => q.topics))].filter((t) => !knownIds.has(t));

const qLabel = (q: (typeof questions)[number]) => `Q${q.q_no}${partLabel(q)}`;
const searchBlob = (q: (typeof questions)[number]) =>
  `${q.stem_text} ${q.text}`.toLowerCase();
const showStem = (q: (typeof questions)[number]) =>
  !!q.stem_text && !/^\d+$/.test(q.stem_text.trim());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIE A-Level 心理学 9990 题库 · Paper 1</title>
    <meta
      name="description"
      content="CIE A-Level 心理学 9990（2024–2026 考纲 Paper 1）公益题库：按 12 篇核心实验与研究切面筛选历年真题。"
    />
  </head>
  <body class="bg-gray-50 text-gray-800">
    <!-- 顶部 -->
    <header class="bg-indigo-700 text-white">
      <div class="max-w-6xl mx-auto px-4 py-6">
        <h1 class="text-2xl font-bold">CIE A-Level 心理学 9990 · 题库</h1>
        <p class="mt-1 text-indigo-100 text-sm">
          慈善 / 非营利 · 免费开放 · 仅收录 <strong>2024–2026 考纲 Paper 1</strong>
          （Approaches / Issues &amp; Debates）· 共 {questions.length} 道真题
        </p>
        <p class="mt-1 text-indigo-200 text-xs">
          界面中文 · 题目英文 · 知识点（12 篇实验）与下拉选项英文 · 不展示 mark scheme
        </p>
      </div>
    </header>

    <!-- 筛选栏（粘性） -->
    <div class="sticky top-0 z-10 bg-white shadow border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap gap-3 items-end">
        <!-- 宏观：试卷（决定下方知识点等筛选项） -->
        <label class="flex flex-col text-xs font-medium text-gray-600">
          试卷
          <select id="f-paper" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">全部试卷</option>
            {papersList.map((p) => <option value={p}>{PAPER_LABELS[p] ?? `Paper ${p}`}</option>)}
          </select>
        </label>

        <!-- 知识点（12 篇实验，可多选） -->
        <div class="flex flex-col text-xs font-medium text-gray-600 grow min-w-[16rem]">
          知识点（可多选）
          <div id="topic-chips" class="mt-1 flex flex-wrap gap-1.5">
            {TOPICS_BY_PAPER[1].map((g) => (
              <div class="contents">
                <span class="w-full text-[10px] text-gray-400 uppercase tracking-wide">{g.label}</span>
                {g.ids.map((id) => (
                  <button
                    type="button"
                    class="topic-chip border border-gray-300 rounded-full px-2.5 py-1 text-xs text-gray-700 hover:bg-indigo-50 hover:border-indigo-300"
                    data-topic={id}
                  >
                    {TOPIC_LABELS[id] ?? id}
                  </button>
                ))}
              </div>
            ))}
            {extraTopics.length > 0 && (
              <div class="contents">
                <span class="w-full text-[10px] text-gray-400 uppercase tracking-wide">其他</span>
                {extraTopics.map((id) => (
                  <button
                    type="button"
                    class="topic-chip border border-gray-300 rounded-full px-2.5 py-1 text-xs text-gray-700 hover:bg-indigo-50 hover:border-indigo-300"
                    data-topic={id}
                  >
                    {TOPIC_LABELS[id] ?? id}
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          研究切面
          <select id="f-type" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800 min-w-[10rem]">
            <option value="">全部研究切面</option>
            {Object.entries(TYPE_LABELS).map(([id, label]) => (
              <option value={id}>{label}</option>
            ))}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          年份
          <select id="f-year" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">全部年份</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          考季
          <select id="f-session" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">全部考季</option>
            {sessions.map((s) => <option value={s}>{SESSION_LABELS[s] ?? s}</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          命令词
          <select id="f-cmd" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">全部命令词</option>
            {cmds.map((c) => <option value={c}>{CMD_LABELS[c] ?? c}</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          分值
          <select id="f-marks" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">全部分值</option>
            {marksList.map((m) => <option value={m}>[{m}]</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600 grow min-w-[12rem]">
          搜索（题面关键词）
          <input
            id="f-search"
            type="search"
            placeholder="如：sample, aim, Baron-Cohen…"
            class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800 w-full"
          />
        </label>

        <button
          id="btn-reset"
          class="text-sm px-3 py-1.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 border border-gray-300"
        >
          重置
        </button>

        <div class="text-xs text-gray-500 self-center">
          命中 <span id="result-count" class="font-semibold text-indigo-700">{questions.length}</span> 题
        </div>
      </div>
    </div>

    <!-- 卡片列表 -->
    <main class="max-w-6xl mx-auto px-4 py-6">
      <div id="qlist" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {questions.map((q) => (
          <article
            class="card bg-white rounded-lg shadow-sm border border-gray-100 p-4 flex flex-col gap-2"
            data-topics={q.topics.join(' ')}
            data-paper={String(q.paper.no)}
            data-type={effectiveType(q)}
            data-year={String(q.series.year)}
            data-session={q.series.session}
            data-cmd={q.command_words.join(' ')}
            data-marks={q.marks != null ? String(q.marks) : ''}
            data-search={searchBlob(q)}
          >
            <div class="flex flex-wrap items-center gap-1.5">
              {sourceTags(q).map((t) => (
                <span class="badge bg-gray-100 text-gray-600">{t}</span>
              ))}
              {q.marks != null && <span class="badge bg-amber-50 text-amber-700">[{q.marks}]</span>}
              {q.has_figure && <span class="badge bg-rose-50 text-rose-700">含图</span>}
            </div>

            {showStem(q) && (
              <p class="text-xs text-gray-500 border-l-2 border-indigo-200 pl-2 italic">{q.stem_text}</p>
            )}

            <p class="qtext text-sm text-gray-900">{q.text}</p>

            <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
              {q.topics.map((t) => (
                <span class="badge bg-emerald-50 text-emerald-700">{TOPIC_LABELS[t] ?? t}</span>
              ))}
              <span class="badge bg-sky-50 text-sky-700">{TYPE_LABELS[effectiveType(q)] ?? effectiveType(q)}</span>
              {q.command_words.map((c) => (
                <span class="badge bg-violet-50 text-violet-700">{CMD_LABELS[c] ?? c}</span>
              ))}
            </div>
          </article>
        ))}
      </div>

      <p id="empty-hint" class="hidden text-center text-gray-400 text-sm py-10">
        没有符合条件的题目，试试调整筛选条件。
      </p>
    </main>

    <footer class="max-w-6xl mx-auto px-4 py-8 text-center text-xs text-gray-400">
      数据来源于历年真题 PDF，按 2024–2026 考纲整理 · 慈善 / 教育用途，免费开放
    </footer>

    <script define:vars={{ TOPICS_BY_PAPER, TOPIC_LABELS }}>
      const $ = (id) => document.getElementById(id);
      const sel = {
        paper: $('f-paper'),
        type: $('f-type'),
        year: $('f-year'),
        session: $('f-session'),
        cmd: $('f-cmd'),
        marks: $('f-marks'),
        search: $('f-search'),
      };
      const chipsBox = $('topic-chips');
      const cards = Array.from(document.querySelectorAll('#qlist .card'));
      const countEl = $('result-count');
      const emptyHint = $('empty-hint');

      let selectedTopics = new Set();

      // 防御性：扫描所有卡片中出现、但不在 TOPICS_BY_PAPER 已知分组里的知识点
      const knownTopics = new Set(
        Object.values(TOPICS_BY_PAPER).flatMap((gs) => gs.flatMap((g) => g.ids))
      );
      let extraTopicsGlobal = [
        ...new Set(
          cards.flatMap((c) => (c.dataset.topics || '').split(' ').filter(Boolean))
        ),
      ].filter((t) => !knownTopics.has(t));

      function rebuildChips(paper) {
        const groups = TOPICS_BY_PAPER[paper] || [];
        chipsBox.innerHTML = '';
        selectedTopics = new Set();
        for (const g of groups) {
          const lbl = document.createElement('span');
          lbl.className = 'w-full text-[10px] text-gray-400 uppercase tracking-wide';
          lbl.textContent = g.label;
          chipsBox.appendChild(lbl);
          for (const id of g.ids) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'topic-chip border border-gray-300 rounded-full px-2.5 py-1 text-xs text-gray-700 hover:bg-indigo-50 hover:border-indigo-300';
            b.dataset.topic = id;
            b.textContent = TOPIC_LABELS[id] ?? id;
            b.addEventListener('click', () => toggleChip(b));
            chipsBox.appendChild(b);
          }
        }
        if (extraTopicsGlobal.length) {
          const lbl = document.createElement('span');
          lbl.className = 'w-full text-[10px] text-gray-400 uppercase tracking-wide';
          lbl.textContent = '其他';
          chipsBox.appendChild(lbl);
          for (const id of extraTopicsGlobal) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'topic-chip border border-gray-300 rounded-full px-2.5 py-1 text-xs text-gray-700 hover:bg-indigo-50 hover:border-indigo-300';
            b.dataset.topic = id;
            b.textContent = TOPIC_LABELS[id] ?? id;
            b.addEventListener('click', () => toggleChip(b));
            chipsBox.appendChild(b);
          }
        }
      }

      function toggleChip(btn) {
        const id = btn.dataset.topic;
        if (selectedTopics.has(id)) {
          selectedTopics.delete(id);
          btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600');
        } else {
          selectedTopics.add(id);
          btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600');
        }
        apply();
      }

      // 初始芯片点击事件（服务端渲染的 P1 芯片）
      chipsBox.querySelectorAll('.topic-chip').forEach((b) =>
        b.addEventListener('click', () => toggleChip(b))
      );

      function apply() {
        const paper = sel.paper.value;
        const type = sel.type.value;
        const year = sel.year.value;
        const session = sel.session.value;
        const cmd = sel.cmd.value;
        const marks = sel.marks.value;
        const q = sel.search.value.trim().toLowerCase();

        let n = 0;
        for (const c of cards) {
          const topics = (c.dataset.topics || '').split(' ').filter(Boolean);
          const cmds = (c.dataset.cmd || '').split(' ').filter(Boolean);
          const okPaper = !paper || c.dataset.paper === paper;
          const okTopic = selectedTopics.size === 0 || topics.some((t) => selectedTopics.has(t));
          const okType = !type || (c.dataset.type || '') === type;
          const okYear = !year || c.dataset.year === year;
          const okSession = !session || c.dataset.session === session;
          const okCmd = !cmd || cmds.includes(cmd);
          const okMarks = !marks || c.dataset.marks === marks;
          const okQ = !q || (c.dataset.search || '').includes(q);
          const show = okPaper && okTopic && okType && okYear && okSession && okCmd && okMarks && okQ;
          c.classList.toggle('is-hidden', !show);
          if (show) n++;
        }
        countEl.textContent = String(n);
        emptyHint.classList.toggle('hidden', n !== 0);
      }

      // 宏观试卷切换：重建知识点下拉内容（需求 4）
      sel.paper.addEventListener('change', () => {
        rebuildChips(Number(sel.paper.value) || 1);
        apply();
      });

      Object.values(sel).forEach((el) => el && el.addEventListener('input', apply));
      $('btn-reset')?.addEventListener('click', () => {
        Object.values(sel).forEach((el) => el && (el.value = ''));
        rebuildChips(1);
        apply();
      });
      apply();
    </script>
  </body>
</html>
