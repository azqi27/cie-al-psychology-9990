---
import '../styles/global.css';
import { questions, effectiveType, seasonEn, partLabel } from '../lib/loadQuestions';
import {
  TOPIC_LABELS,
  TYPE_LABELS,
  CMD_LABELS,
  TOPICS_BY_PAPER,
  SESSION_LABELS,
  PAPER_LABELS,
} from '../lib/taxonomy';

const years = [...new Set(questions.map((q) => q.series.year))].sort((a, b) => a - b);
const sessions = [...new Set(questions.map((q) => q.series.session))].sort();
const cmds = [...new Set(questions.flatMap((q) => q.command_words))].filter(Boolean).sort();
const marksList = [
  ...new Set(questions.map((q) => q.marks).filter((m): m is number => m != null)),
].sort((a, b) => a - b);
const papersList = [1, 2, 3, 4];

const groupKey = (q: (typeof questions)[number]) =>
  `${q.paper.no}-${q.series.year}-${q.series.session}-${q.paper.variant}-${q.q_no}`;

const groupUid = (q: (typeof questions)[number]) =>
  q.uid.replace(/([0-9]+)[a-z]+$/i, '$1');

interface QGroup {
  key: string;
  uid: string;
  source: string[];
  paper_no: number;
  year: number;
  session: string;
  variant: number;
  q_no: string;
  stem_text: string;
  items: (typeof questions)[number][];
  topics: string[];
  types: string[];
  cmds: string[];
  marks: number[];
  has_figure: boolean;
  searchBlob: string;
}

const groups: QGroup[] = [];
const seen = new Map<string, QGroup>();
for (const q of questions) {
  const k = groupKey(q);
  let g = seen.get(k);
  if (!g) {
    g = {
      key: k,
      uid: groupUid(q),
      source: [
        '9990',
        String(q.series.year),
        seasonEn(q),
        PAPER_LABELS[q.paper.no] ?? `Paper ${q.paper.no}`,
        `Variant ${q.paper.variant}`,
        `Q${q.q_no}`,
      ],
      paper_no: q.paper.no,
      year: q.series.year,
      session: q.series.session,
      variant: q.paper.variant,
      q_no: q.q_no,
      stem_text: (q.stem_text || '').trim(),
      items: [],
      topics: [],
      types: [],
      cmds: [],
      marks: [],
      has_figure: false,
      searchBlob: '',
    };
    seen.set(k, g);
    groups.push(g);
  }
  g.items.push(q);
}

for (const g of groups) {
  const topics = new Set<string>();
  const types = new Set<string>();
  const cmds = new Set<string>();
  const marks: number[] = [];
  let search = g.stem_text.toLowerCase();
  for (const q of g.items) {
    q.topics.forEach((t) => topics.add(t));
    types.add(effectiveType(q));
    q.command_words.forEach((c) => cmds.add(c));
    if (q.marks != null) marks.push(q.marks);
    if (q.has_figure) g.has_figure = true;
    search += ' ' + q.text.toLowerCase();
  }
  g.topics = [...topics];
  g.types = [...types];
  g.cmds = [...cmds];
  g.marks = [...new Set(marks)].sort((a, b) => a - b);
  g.searchBlob = search;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CIE A-Level Psychology 9990</title>
    <meta
      name="description"
      content="CIE A-Level Psychology 9990 question bank — past paper questions filtered by the 12 core studies (2024–2026 syllabus, Paper 1)."
    />
  </head>
  <body class="bg-gray-50 text-gray-800">
    <!-- 顶部：仅保留大标题 -->
    <header class="site-header">
      <div class="max-w-6xl mx-auto px-4 py-4">
        <h1>CIE A-Level Psychology 9990</h1>
      </div>
    </header>

    <!-- 筛选栏（粘性） -->
    <div class="sticky top-0 z-10 bg-white shadow border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap gap-3 items-end">
        <!-- 宏观：试卷（决定下方知识点等筛选项） -->
        <label class="flex flex-col text-xs font-medium text-gray-600">
          Paper
          <select id="f-paper" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">All papers</option>
            {papersList.map((p) => <option value={p}>{PAPER_LABELS[p] ?? `Paper ${p}`}</option>)}
          </select>
        </label>

        <!-- 知识点（12 篇实验 + 4 视角，单选下拉；卡片标签仍可为多） -->
        <label class="flex flex-col text-xs font-medium text-gray-600">
          Study
          <select id="f-topic" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800 min-w-[14rem]">
            <option value="">All studies</option>
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          Research facet
          <select id="f-type" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800 min-w-[10rem]">
            <option value="">All facets</option>
            {Object.entries(TYPE_LABELS).map(([id, label]) => (
              <option value={id}>{label}</option>
            ))}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          Year
          <select id="f-year" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">All years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          Session
          <select id="f-session" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">All sessions</option>
            {sessions.map((s) => <option value={s}>{SESSION_LABELS[s] ?? s}</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          Command word
          <select id="f-cmd" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">All command words</option>
            {cmds.map((c) => <option value={c}>{CMD_LABELS[c] ?? c}</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600">
          Marks
          <select id="f-marks" class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800">
            <option value="">All marks</option>
            {marksList.map((m) => <option value={m}>[{m}]</option>)}
          </select>
        </label>

        <label class="flex flex-col text-xs font-medium text-gray-600 grow min-w-[12rem]">
          Search
          <input
            id="f-search"
            type="search"
            placeholder="e.g. sample, aim, Baron-Cohen…"
            class="mt-1 border rounded px-2 py-1.5 text-sm text-gray-800 w-full"
          />
        </label>

        <button
          id="btn-reset"
          class="text-sm px-3 py-1.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 border border-gray-300"
        >
          重置
        </button>

        <div class="text-xs text-gray-500 self-center">
          匹配到 <span id="result-count" class="font-semibold text-theme-dark">{groups.length}</span> 题
        </div>
      </div>
    </div>

    <!-- 卡片列表 -->
    <main class="max-w-6xl mx-auto px-4 py-6">
      <div id="qlist" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {groups.map((g) => (
          <article
            class="card bg-white rounded-lg shadow-sm border border-gray-100 p-4 flex flex-col gap-2"
            data-topics={g.topics.join(' ')}
            data-paper={String(g.paper_no)}
            data-type={g.types.join(' ')}
            data-year={String(g.year)}
            data-session={g.session}
            data-cmd={g.cmds.join(' ')}
            data-marks={g.marks.join(' ')}
            data-search={g.searchBlob}
          >
            <div class="flex flex-wrap items-center gap-1.5">
              {g.source.map((t) => (
                <span class="badge bg-gray-100 text-gray-600">{t}</span>
              ))}
              {g.marks.map((m) => <span class="badge bg-amber-50 text-amber-700">[{m}]</span>)}
              {g.has_figure && <span class="badge bg-rose-50 text-rose-700">含图</span>}
              <span class="q-uid ml-auto">№ {g.uid}</span>
            </div>

            <div class="question-body text-sm text-gray-900">
              {g.stem_text && g.items.some((q) => q.part) && (
                <p>{g.stem_text}</p>
              )}
              {g.items.map((q) => (
                <p>
                  {q.part && <span class="part-label">{partLabel(q)}</span>}
                  {q.text}
                </p>
              ))}
            </div>

            <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
              {g.topics.map((t) => (
                <span class="badge bg-emerald-50 text-emerald-700">{TOPIC_LABELS[t] ?? t}</span>
              ))}
              {g.types.map((t) => <span class="badge bg-sky-50 text-sky-700">{TYPE_LABELS[t] ?? t}</span>)}
              {g.cmds.map((c) => <span class="badge bg-violet-50 text-violet-700">{CMD_LABELS[c] ?? c}</span>)}
            </div>
          </article>
        ))}
      </div>

      <p id="empty-hint" class="hidden text-center text-gray-400 text-sm py-10">
        没有符合条件的题目，试试调整筛选条件。
      </p>
    </main>

    <footer class="max-w-6xl mx-auto px-4 py-8 text-center text-xs text-gray-400">
      题目整理自历年真题 PDF · 按 2024–2026 考纲
    </footer>

    <script define:vars={{ TOPICS_BY_PAPER, TOPIC_LABELS }}>
      const $ = (id) => document.getElementById(id);
      const sel = {
        paper: $('f-paper'),
        topic: $('f-topic'),
        type: $('f-type'),
        year: $('f-year'),
        session: $('f-session'),
        cmd: $('f-cmd'),
        marks: $('f-marks'),
        search: $('f-search'),
      };
      const topicSel = sel.topic;
      const cards = Array.from(document.querySelectorAll('#qlist .card'));
      const countEl = $('result-count');
      const emptyHint = $('empty-hint');

      // 知识点（实验/视角）分组在卡片数据中出现、但不在已知分组里的，作为“其他”兜底
      const knownTopics = new Set(
        Object.values(TOPICS_BY_PAPER).flatMap((gs) => gs.flatMap((g) => g.ids))
      );
      const extraTopics = [
        ...new Set(cards.flatMap((c) => (c.dataset.topics || '').split(' ').filter(Boolean))),
      ].filter((t) => !knownTopics.has(t));

      // 宏观 Paper 切换：重建“Study”下拉（单选）
      function rebuildTopic(paper) {
        const groups = TOPICS_BY_PAPER[paper] || [];
        topicSel.innerHTML = '';
        const all = document.createElement('option');
        all.value = '';
        all.textContent = 'All studies';
        topicSel.appendChild(all);
        for (const g of groups) {
          const og = document.createElement('optgroup');
          og.label = g.label;
          for (const id of g.ids) {
            const o = document.createElement('option');
            o.value = id;
            o.textContent = TOPIC_LABELS[id] ?? id;
            og.appendChild(o);
          }
          topicSel.appendChild(og);
        }
        if (extraTopics.length) {
          const og = document.createElement('optgroup');
          og.label = 'Other';
          for (const id of extraTopics) {
            const o = document.createElement('option');
            o.value = id;
            o.textContent = TOPIC_LABELS[id] ?? id;
            og.appendChild(o);
          }
          topicSel.appendChild(og);
        }
      }

      function apply() {
        const paper = sel.paper.value;
        const topic = sel.topic.value;
        const type = sel.type.value;
        const year = sel.year.value;
        const session = sel.session.value;
        const cmd = sel.cmd.value;
        const marks = sel.marks.value;
        const q = sel.search.value.trim().toLowerCase();

        let n = 0;
        for (const c of cards) {
          const topics = (c.dataset.topics || '').split(' ').filter(Boolean);
          const cmds = (c.dataset.cmd || '').split(' ').filter(Boolean);
          const types = (c.dataset.type || '').split(' ').filter(Boolean);
          const marksSet = (c.dataset.marks || '').split(' ').filter(Boolean);
          const okPaper = !paper || c.dataset.paper === paper;
          const okTopic = !topic || topics.includes(topic);
          const okType = !type || types.includes(type);
          const okYear = !year || c.dataset.year === year;
          const okSession = !session || c.dataset.session === session;
          const okCmd = !cmd || cmds.includes(cmd);
          const okMarks = !marks || marksSet.includes(marks);
          const okQ = !q || (c.dataset.search || '').includes(q);
          const show = okPaper && okTopic && okType && okYear && okSession && okCmd && okMarks && okQ;
          c.classList.toggle('is-hidden', !show);
          if (show) n++;
        }
        countEl.textContent = String(n);
        emptyHint.classList.toggle('hidden', n !== 0);
      }

      sel.paper.addEventListener('change', () => {
        rebuildTopic(Number(sel.paper.value) || 1);
        apply();
      });

      Object.values(sel).forEach((el) => el && el.addEventListener('input', apply));
      $('btn-reset')?.addEventListener('click', () => {
        Object.values(sel).forEach((el) => el && (el.value = ''));
        rebuildTopic(1);
        apply();
      });
      rebuildTopic(1);
      apply();
    </script>
  </body>
</html>
